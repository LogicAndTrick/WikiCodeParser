{
  "name": "logic-and-trick/twhl-wikicode-parser",
  "description": "TWHL WikiCode parser for PHP",
  "license": "MIT",
  "require": {
    "php": "^8.4"
  },
  "require-dev": {
    "phpstan/phpstan": "^2",
    "phpunit/phpunit": "^12"
  },
  "autoload": {
    "psr-4": {
      "LogicAndTrick\\WikiCodeParser\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LogicAndTrick\\WikiCodeParser\\": "test"
    }
  },
  "config": {
    "platform": {
      "php": "8.4"
    },
    "sort-packages": true
  },
  "scripts": {
    "analyse": "phpstan analyse --configuration=phpstan.neon",
    "test": "phpunit --configuration phpunit.xml --display-deprecations"
  }
}
