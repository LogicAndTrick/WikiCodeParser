{
  "$schema": "_schema.json",
  "config": {
    "base": "none",
    "processors": ["MarkdownText"]
  },
  "input": "*bold* /italic/ _underline_ ~strikethrough~ `code`\n`code with *escaped* markdown`\n*nested /markdown ~formatting~/*",
  "html": "<strong>bold</strong> <em>italic</em> <span class=\"underline\">underline</span> <span class=\"strikethrough\">strikethrough</span> <code>code</code>\n<code>code with *escaped* markdown</code>\n<strong>nested <em>markdown <span class=\"strikethrough\">formatting</span></em></strong>",
  "plain": "*bold* /italic/ _underline_ ~strikethrough~ `code`\n`code with *escaped* markdown`\n*nested /markdown ~formatting~/*",
  "nodes": {
    "name": "root",
    "type": "list",
    "pos": [1, 0],
    "children": [
      {
        "type": "list",
        "pos": [1, 0],
        "children": [
          {
            "type": "html",
            "pos": [1, 0],
            "html": ["<strong>", "</strong>"],
            "plain": ["*", "*"],
            "children": [{ "type": "plain", "pos": [1, 1], "text": "bold" }]
          },
          { "type": "plain", "pos": [1, 6], "text": " " },
          {
            "type": "html",
            "pos": [1, 7],
            "html": ["<em>", "</em>"],
            "plain": ["/", "/"],
            "children": [{ "type": "plain", "pos": [1, 8], "text": "italic" }]
          },
          { "type": "plain", "pos": [1, 15], "text": " " },
          {
            "type": "html",
            "pos": [1, 16],
            "html": ["<span class=\"underline\">", "</span>"],
            "plain": ["_", "_"],
            "children": [
              { "type": "plain", "pos": [1, 17], "text": "underline" }
            ]
          },
          { "type": "plain", "pos": [1, 27], "text": " " },
          {
            "type": "html",
            "pos": [1, 28],
            "html": ["<span class=\"strikethrough\">", "</span>"],
            "plain": ["~", "~"],
            "children": [
              { "type": "plain", "pos": [1, 29], "text": "strikethrough" }
            ]
          },
          { "type": "plain", "pos": [1, 43], "text": " " },
          {
            "type": "html",
            "pos": [1, 44],
            "html": ["<code>", "</code>"],
            "plain": ["`", "`"],
            "children": [{ "type": "plain", "pos": [1, 45], "text": "code" }]
          },
          { "type": "plain", "pos": [1, 50], "text": "\n" },
          {
            "type": "html",
            "pos": [2, 0],
            "html": ["<code>", "</code>"],
            "plain": ["`", "`"],
            "children": [
              {
                "type": "plain",
                "pos": [2, 1],
                "text": "code with *escaped* markdown"
              }
            ]
          },
          { "type": "plain", "pos": [2, 30], "text": "\n" },
          {
            "type": "html",
            "pos": [3, 0],
            "html": ["<strong>", "</strong>"],
            "plain": ["*", "*"],
            "children": [
              {
                "type": "list",
                "pos": [3, 1],
                "children": [
                  {
                    "type": "plain",
                    "pos": [3, 1],
                    "text": "nested "
                  },
                  {
                    "type": "html",
                    "pos": [3, 8],
                    "html": ["<em>", "</em>"],
                    "plain": ["/", "/"],
                    "children": [
                      {
                        "type": "list",
                        "pos": [3, 9],
                        "children": [
                          {
                            "type": "plain",
                            "pos": [3, 9],
                            "text": "markdown "
                          },
                          {
                            "type": "html",
                            "pos": [3, 18],
                            "html": [
                              "<span class=\"strikethrough\">",
                              "</span>"
                            ],
                            "plain": ["~", "~"],
                            "children": [
                              {
                                "type": "plain",
                                "pos": [3, 19],
                                "text": "formatting"
                              }
                            ]
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
